{
  "formatVersion": 1,
  "patterns": [
    {
      "id": "aws-access-token",
      "provider": "aws",
      "regex": "(?-u)\\b((?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16})\\b"
    },
    {
      "id": "aws-amazon-bedrock-api-key-long-lived",
      "provider": "aws",
      "regex": "(?-u)\\b(ABSK[A-Za-z0-9+/]{109,269}={0,2})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "anthropic-api-key",
      "provider": "anthropic",
      "regex": "(?-u)\\b(sk-ant-api03-[a-zA-Z0-9_\\-]{93}AA)(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "anthropic-admin-api-key",
      "provider": "anthropic",
      "regex": "(?-u)\\b(sk-ant-admin01-[a-zA-Z0-9_\\-]{93}AA)(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "openai-api-key",
      "provider": "openai",
      "regex": "(?-u)\\b(sk-(?:proj|svcacct|admin)-(?:[A-Za-z0-9_-]{74}|[A-Za-z0-9_-]{58})T3BlbkFJ(?:[A-Za-z0-9_-]{74}|[A-Za-z0-9_-]{58})\\b|sk-[a-zA-Z0-9]{20}T3BlbkFJ[a-zA-Z0-9]{20})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "stripe-access-token",
      "provider": "stripe",
      "regex": "(?-u)\\b((?:sk|rk)_(?:test|live|prod)_[a-zA-Z0-9]{10,99})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "github-pat",
      "provider": "github",
      "regex": "(?-u)ghp_[0-9a-zA-Z]{36}"
    },
    {
      "id": "github-fine-grained-pat",
      "provider": "github",
      "regex": "(?-u)github_pat_\\w{82}"
    },
    {
      "id": "github-oauth",
      "provider": "github",
      "regex": "(?-u)gho_[0-9a-zA-Z]{36}"
    },
    {
      "id": "github-app-token",
      "provider": "github",
      "regex": "(?-u)(?:ghu|ghs)_[0-9a-zA-Z]{36}"
    },
    {
      "id": "github-refresh-token",
      "provider": "github",
      "regex": "(?-u)ghr_[0-9a-zA-Z]{36}"
    },
    {
      "id": "gitlab-pat",
      "provider": "gitlab",
      "regex": "(?-u)glpat-[\\w-]{20}"
    },
    {
      "id": "gitlab-pat-routable",
      "provider": "gitlab",
      "regex": "(?-u)\\bglpat-[0-9a-zA-Z_-]{27,300}\\.[0-9a-z]{2}[0-9a-z]{7}\\b"
    },
    {
      "id": "gcp-api-key",
      "provider": "google",
      "regex": "(?-u)\\b(AIza[\\w-]{35})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "slack-app-token",
      "provider": "slack",
      "regex": "(?-u)(?i)xapp-\\d-[A-Z0-9]+-\\d+-[a-z0-9]+"
    },
    {
      "id": "slack-bot-token",
      "provider": "slack",
      "regex": "(?-u)xoxb-[0-9]{10,13}-[0-9]{10,13}[a-zA-Z0-9-]*"
    },
    {
      "id": "slack-config-access-token",
      "provider": "slack",
      "regex": "(?i)xoxe.xox[bp]-\\d-[A-Z0-9]{163,166}"
    },
    {
      "id": "slack-config-refresh-token",
      "provider": "slack",
      "regex": "(?-u)(?i)xoxe-\\d-[A-Z0-9]{146}"
    },
    {
      "id": "slack-legacy-bot-token",
      "provider": "slack",
      "regex": "(?-u)xoxb-[0-9]{8,14}-[a-zA-Z0-9]{18,26}"
    },
    {
      "id": "slack-legacy-token",
      "provider": "slack",
      "regex": "(?-u)xox[os]-\\d+-\\d+-\\d+-[a-fA-F\\d]+"
    },
    {
      "id": "slack-legacy-workspace-token",
      "provider": "slack",
      "regex": "(?-u)xox[ar]-(?:\\d-)?[0-9a-zA-Z]{8,48}"
    },
    {
      "id": "slack-user-token",
      "provider": "slack",
      "regex": "(?-u)xox[pe](?:-[0-9]{10,13}){3}-[a-zA-Z0-9-]{28,34}"
    },
    {
      "id": "slack-webhook-url",
      "provider": "slack",
      "regex": "(?:https?://)?hooks.slack.com/(?:services|workflows|triggers)/[A-Za-z0-9+/]{43,56}"
    },
    {
      "id": "npm-access-token",
      "provider": "npm",
      "regex": "(?-u)(?i)\\b(npm_[a-z0-9]{36})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "pypi-upload-token",
      "provider": "pypi",
      "regex": "(?-u)pypi-AgEIcHlwaS5vcmc[\\w-]{50,1000}"
    },
    {
      "id": "rubygems-api-token",
      "provider": "rubygems",
      "regex": "(?-u)\\b(rubygems_[a-f0-9]{48})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "sendgrid-api-token",
      "provider": "sendgrid",
      "regex": "(?-u)\\b(SG\\.(?i)[a-z0-9=_\\-\\.]{66})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "shopify-access-token",
      "provider": "shopify",
      "regex": "(?-u)shpat_[a-fA-F0-9]{32}"
    },
    {
      "id": "shopify-custom-access-token",
      "provider": "shopify",
      "regex": "(?-u)shpca_[a-fA-F0-9]{32}"
    },
    {
      "id": "shopify-private-app-access-token",
      "provider": "shopify",
      "regex": "(?-u)shppa_[a-fA-F0-9]{32}"
    },
    {
      "id": "shopify-shared-secret",
      "provider": "shopify",
      "regex": "(?-u)shpss_[a-fA-F0-9]{32}"
    },
    {
      "id": "digitalocean-pat",
      "provider": "digitalocean",
      "regex": "(?-u)\\b(dop_v1_[a-f0-9]{64})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "huggingface-access-token",
      "provider": "huggingface",
      "regex": "(?-u)\\b(hf_(?i:[a-z]{34}))(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "perplexity-api-key",
      "provider": "perplexity",
      "regex": "(?-u)\\b(pplx-[a-zA-Z0-9]{48})(?:[\\x60'\"\\s;]|\\\\[nr]|$|\\b)"
    },
    {
      "id": "planetscale-api-token",
      "provider": "planetscale",
      "regex": "(?-u)\\b(pscale_tkn_(?i)[\\w=\\.-]{32,64})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "pulumi-api-token",
      "provider": "pulumi",
      "regex": "(?-u)\\b(pul-[a-f0-9]{40})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "sentry-user-token",
      "provider": "sentry",
      "regex": "(?-u)\\b(sntryu_[a-f0-9]{64})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "sentry-org-token",
      "provider": "sentry",
      "regex": "\\bsntrys_eyJpYXQiO[a-zA-Z0-9+/]{10,200}(?:LCJyZWdpb25fdXJs|InJlZ2lvbl91cmwi|cmVnaW9uX3VybCI6)[a-zA-Z0-9+/]{10,200}={0,2}_[a-zA-Z0-9+/]{43}(?:[^a-zA-Z0-9+/]|\\z)"
    },
    {
      "id": "square-access-token",
      "provider": "square",
      "regex": "(?-u)\\b((?:EAAA|sq0atp-)[\\w-]{22,60})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "hashicorp-tf-api-token",
      "provider": "hashicorp",
      "regex": "(?-u)(?i)[a-z0-9]{14}\\.(?-i:atlasv1)\\.[a-z0-9\\-_=]{60,70}"
    },
    {
      "id": "doppler-api-token",
      "provider": "doppler",
      "regex": "(?-u)dp\\.pt\\.(?i)[a-z0-9]{43}"
    },
    {
      "id": "linear-api-key",
      "provider": "linear",
      "regex": "(?-u)lin_api_(?i)[a-z0-9]{40}"
    },
    {
      "id": "grafana-api-key",
      "provider": "grafana",
      "regex": "(?-u)(?i)\\b(eyJrIjoi[A-Za-z0-9]{70,400}={0,3})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "grafana-cloud-api-token",
      "provider": "grafana",
      "regex": "(?-u)(?i)\\b(glc_[A-Za-z0-9+/]{32,400}={0,3})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "grafana-service-account-token",
      "provider": "grafana",
      "regex": "(?-u)(?i)\\b(glsa_[A-Za-z0-9]{32}_[A-Fa-f0-9]{8})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "age-secret-key",
      "provider": "age",
      "regex": "(?-u)AGE-SECRET-KEY-1[QPZRY9X8GF2TVDW0S3JN54KHCE6MUA7L]{58}"
    },
    {
      "id": "flyio-access-token",
      "provider": "flyio",
      "regex": "(?-u)\\b((?:fo1_[\\w-]{43}|fm1[ar]_[a-zA-Z0-9+\\/]{100,}={0,3}|fm2_[a-zA-Z0-9+\\/]{100,}={0,3}))(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "cloudflare-origin-ca-key",
      "provider": "cloudflare",
      "regex": "(?-u)\\b(v1\\.0-[a-f0-9]{24}-[a-f0-9]{146})(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "heroku-api-key-v2",
      "provider": "heroku",
      "regex": "(?-u)\\b((HRKU-AA[0-9a-zA-Z_-]{58}))(?:[\\x60'\"\\s;]|\\\\[nr]|$)"
    },
    {
      "id": "private-key",
      "provider": "pem",
      "regex": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----"
    },
    {
      "id": "supabase-jwt",
      "provider": "supabase",
      "regex": "\\beyJ[A-Za-z0-9_-]{15,}\\.eyJpc3MiOiJzdXBhYmFzZSI[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]{20,}"
    },
    {
      "id": "supabase-secret-key",
      "provider": "supabase",
      "regex": "\\bsb_secret_[A-Za-z0-9_-]{20,}"
    }
  ]
}
