  { "node": "NewTarget", "bcd": "javascript.operators.new_target" },
  { "node": "ImportExpression", "bcd": "javascript.operators.import" },
  { "node": "ImportMeta", "bcd": "javascript.operators.import_meta" },
  { "node": "ImportDeclaration", "bcd": "javascript.statements.import" },
  { "node": "ImportAttribute", "bcd": "javascript.statements.import.import_attributes" },
  { "node": "ExportNamedDeclaration", "bcd": "javascript.statements.export" },
  { "node": "ExportDefaultDeclaration", "bcd": "javascript.statements.export.default" },
  { "node": "ExportAllDeclaration", "bcd": "javascript.statements.export" },
  { "node": "Hashbang", "bcd": "javascript.grammar.hashbang_comments" },
  { "node": "BigIntLiteral", "bcd": "javascript.builtins.BigInt" },
  { "node": "VariableDeclaration", "when": { "kind": "using" }, "bcd": "javascript.statements.using" },
