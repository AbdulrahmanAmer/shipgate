[
  { "node": "ChainExpression", "bcd": "javascript.operators.optional_chaining" },
  { "node": "LogicalExpression", "when": { "operator": "??" }, "bcd": "javascript.operators.nullish_coalescing" },
  { "node": "AssignmentExpression", "when": { "operator": "??=" }, "bcd": "javascript.operators.nullish_coalescing_assignment" },
  { "node": "AssignmentExpression", "when": { "operator": "||=" }, "bcd": "javascript.operators.logical_or_assignment" },
  { "node": "AssignmentExpression", "when": { "operator": "&&=" }, "bcd": "javascript.operators.logical_and_assignment" },
  { "node": "BinaryExpression", "when": { "operator": "**" }, "bcd": "javascript.operators.exponentiation" },
