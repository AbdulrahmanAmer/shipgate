  { "node": "Function", "when": { "type": "FunctionDeclaration", "async": true, "generator": true }, "bcd": "javascript.statements.async_generator_function" },
  { "node": "Function", "when": { "type": "FunctionExpression", "async": true, "generator": true }, "bcd": "javascript.operators.async_generator_function" },
  { "node": "AwaitExpression", "bcd": "javascript.operators.await" },
  { "node": "YieldExpression", "bcd": "javascript.operators.yield" },
  { "node": "ForOfStatement", "bcd": "javascript.statements.for_of" },
  { "node": "ForOfStatement", "when": { "await": true }, "bcd": "javascript.statements.for_await_of" },
  { "node": "CatchClause", "when": { "param": null }, "bcd": "javascript.statements.try_catch.optional_catch_binding" },
  { "node": "TemplateLiteral", "bcd": "javascript.grammar.template_literals" },
  { "node": "TaggedTemplateExpression", "bcd": "javascript.grammar.template_literals" },
  { "node": "SpreadElement", "bcd": "javascript.operators.spread" },
  { "node": "ObjectPattern", "bcd": "javascript.operators.destructuring" },
