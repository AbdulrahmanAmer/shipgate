  { "node": "Class", "when": { "type": "ClassDeclaration" }, "bcd": "javascript.statements.class" },
  { "node": "Class", "when": { "type": "ClassExpression" }, "bcd": "javascript.operators.class" },
  { "node": "PropertyDefinition", "bcd": "javascript.classes.public_class_fields" },
  { "node": "PropertyDefinition", "when": { "static": true }, "bcd": "javascript.classes.static.class_fields" },
  { "node": "PrivateIdentifier", "bcd": "javascript.classes.private_class_fields" },
