{
  "node": {
    "identity": "major",
    "sources": [
      {
        "file": "package.json",
        "kind": "manifest",
        "extract": "\"engines\"\\s*:\\s*\\{[^}]*?\"node\"\\s*:\\s*\"([^\"]+)\""
      },
      {
        "file": ".nvmrc",
        "kind": "manifest",
        "extract": "(?m)^\\s*v?([^\\s#]+)"
      },
      {
        "file": ".node-version",
        "kind": "manifest",
        "extract": "(?m)^\\s*v?([^\\s#]+)"
      },
      {
        "file": ".tool-versions",
        "kind": "manifest",
        "extract": "(?m)^\\s*(?:nodejs|node)\\s+v?(\\S+)"
      },
      {
        "file": "mise.toml",
        "kind": "manifest",
        "extract": "(?m)^\\s*node\\s*=\\s*[\"']?([^\"'\\s#,]+)"
      },
      {
        "file": ".github/workflows/*.{yml,yaml}",
        "kind": "ci",
        "extract": "node-version:\\s*[\"']?v?([^\"'\\s#,]+)"
      },
      {
        "file": ".gitlab-ci.yml",
        "kind": "ci",
        "extract": "image:\\s*[\"']?node:v?([0-9][^\"'\\s#-]*)"
      },
      {
        "file": ".circleci/config.yml",
        "kind": "ci",
        "extract": "cimg/node:v?([0-9][^\"'\\s#]*)"
      },
      {
        "file": "netlify.toml",
        "kind": "host",
        "extract": "(?m)^\\s*NODE_VERSION\\s*=\\s*[\"']?v?([^\"'\\s#]+)"
      },
      {
        "file": "wrangler.{toml,jsonc,json}",
        "kind": "host",
        "extract": "NODE_VERSION[\"']?\\s*[=:]\\s*[\"']?v?([^\"'\\s#,}]+)"
      }
    ]
  },
